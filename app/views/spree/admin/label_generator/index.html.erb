<%= render 'spree/admin/shared/order_tabs', current: :item_boxes %>

<% content_for :page_title do %>
  / <%= Spree.t(:item_request_boxes) %>
<% end %>

<div class="table-responsive border rounded bg-white">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Shipping Label</th>
        <th scope="col">Return Label</th>
      </tr>
    </thead>
    <tbody>
      <% @line_items.each do |line_item| %>
        <% product_taxons = line_item.variant.product.taxons.map(&:name) %>
        <% all_taxons = Spree::Taxon.pluck(:name) %>
        <% if (product_taxons & all_taxons).any? %>
          <tr>
            <td class="text-center">
              <%= render 'label_generator_section', 
                        line_item: line_item, 
                        label_type: :shipping, 
                        label_url: line_item.item_box_shipping_label, 
                        country_id: line_item.order.ship_address.country_id, 
                        generate_path: ship_label_admin_order_label_generator_path(line_item.order.number, line_item.id), 
                        regenerate_path: ship_label_admin_order_label_generator_path(line_item.order.number, line_item.id) %>
            </td>
            <td class="text-center">
              <%= render 'label_generator_section', 
                        line_item: line_item, 
                        label_type: :return, 
                        label_url: line_item.item_box_return_label, 
                        country_id: line_item.order.ship_address.country_id, 
                        generate_path: return_label_admin_order_label_generator_path(line_item.order.number, line_item.id), 
                        regenerate_path: return_label_admin_order_label_generator_path(line_item.order.number, line_item.id) %>
            </td>
          </tr>
        <% else %>
          <tr>
            <td colspan="3" class="text-center text-muted">
              <%= Spree.t(:not_applicable) %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
